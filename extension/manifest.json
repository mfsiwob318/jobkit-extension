{
  "manifest_version": 3,
  "name": "JobKit — Job Application Assistant",
  "version": "1.0.0",
  "description": "Build a tailored application kit, fill forms with your review, and track applications.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "action": { "default_title": "JobKit", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
